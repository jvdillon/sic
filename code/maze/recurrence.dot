// dot -Tpng recurrence.dot -o recurrence.png
digraph recurrence {
  rankdir=TB;
  node [shape=circle, fontname="serif"];
  nodesep=0.6;
  ranksep=0.4;

  // Invisible input nodes (keep arrows, no label)
  "in_θ" [shape=none, label="", width=0, height=0, group=theta];
  "in_z" [shape=none, label="", width=0, height=0, group=z];

  // Nodes (group keeps each column vertically aligned)
  "θ₀" [group=theta]; "z₀" [group=z]; "L₀" [group=L];
  "θ₁" [group=theta]; "z₁" [group=z]; "L₁" [group=L];
  "θ₂" [group=theta]; "z₂" [group=z];

  // Row alignment
  { rank=same; "in_θ"; "in_z"; }
  { rank=same; "θ₀"; "z₀"; }
  { rank=same; "θ₁"; "z₁"; }
  { rank=same; "θ₂"; "z₂"; }

  // Leading (arrows from invisible points)
  "in_θ" -> "θ₀";
  "in_z" -> "z₀";

  // i=0
  "θ₀" -> "z₀";
  "θ₀" -> "L₀";
  "z₀" -> "L₀";
  "θ₀" -> "θ₁" [weight=2];
  "L₀" -> "θ₁";
  "z₀" -> "z₁" [weight=2];

  // i=1
  "θ₁" -> "z₁";
  "θ₁" -> "L₁";
  "z₁" -> "L₁";
  "θ₁" -> "θ₂" [weight=2];
  "L₁" -> "θ₂";
  "z₁" -> "z₂" [weight=2];
}
